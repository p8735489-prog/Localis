         externalNativeBuild {
             cmake {
                 cppFlags("-std=c++17", "-fexceptions", "-frtti")
-                arguments("-DANDROID_STL=c++_shared")
+                arguments(
+                    "-DANDROID_STL=c++_shared",
+                    // The Vulkan backend's shader generator runs on the HOST at build
+                    // time and depends on the host-installed SPIRV-Headers/glslc
+                    // packages (ggml-vulkan/CMakeLists.txt: find_package(SPIRV-Headers
+                    // CONFIG REQUIRED)). The Android NDK toolchain file defaults
+                    // CMAKE_FIND_ROOT_PATH_MODE_PACKAGE to ONLY, which restricts every
+                    // find_package() call to the NDK sysroot only -- so even though CI
+                    // apt-installs spirv-headers on the runner, CMake can never see it
+                    // and configuration fails with "Could not find ... SPIRV-Headers".
+                    // BOTH lets find_package() also search the normal host prefix path.
+                    "-DCMAKE_FIND_ROOT_PATH_MODE_PACKAGE=BOTH"
+                )
             }
         }
         ndk {
